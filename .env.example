# Database
DATABASE_URL=postgresql://user:password@localhost:5432/delivery24
# Or Supabase:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30d

# Redis (for OTP/caching)
REDIS_URL=redis://localhost:6379

# Storage (Supabase Storage or S3)
STORAGE_TYPE=supabase
STORAGE_BUCKET=delivery24
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# SMS (Fast2SMS / Twilio)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your-key
SMS_SENDER_ID=DELIV24

# Maps (Google Maps or OpenStreetMap)
MAPS_PROVIDER=google
GOOGLE_MAPS_KEY=your-key

# App
PORT=4000
NODE_ENV=development
SUPERADMIN_PHONE=9949808388
MAX_PRODUCT_IMAGES=5
OTP_EXPIRY_MINUTES=10
OTP_DEMO_MODE=true